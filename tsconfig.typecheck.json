{
  "//": "仅对项目自有的 TypeScript 源码做类型检查（不检查 1429 个 JS 示例组件）。",
  "//2": "全量 vue-tsc 在本项目会产生海量噪声（绝大多数文件是 JS），因此 CI 用这份收敛配置。",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "env.d.ts"],
  "exclude": ["node_modules", "dist", "src/examples/jsm-compat", "src/examples/three-build-compat"],
  "references": []
}
