{
  "name": "curio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/copy-example-deps.js",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit && vue-tsc -p server/tsconfig.json --noEmit",
    "lint": "eslint . --fix",
    "lint:ci": "eslint .",
    "format": "prettier --write \"src/**/*.{vue,js,ts,css}\"",
    "test:e2e": "playwright test",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:server": "npm --prefix server run test",
    "dev:server": "npm --prefix server run dev",
    "start:server": "npm --prefix server run start",
    "refresh:quakes": "node scripts/refresh-quake-snapshot.mjs",
    "audit:deps": "node scripts/audit-deps.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "verify:registry": "node --experimental-strip-types scripts/verify-registry.mjs",
    "verify:drift": "node --experimental-strip-types scripts/generate-registry.js --check",
    "verify:thumbnails": "node --experimental-strip-types scripts/verify-thumbnails.mjs",
    "verify:three-compat": "node scripts/verify-three-compat.mjs",
    "verify:gl-renderer": "node scripts/generate-gl-renderer-esm.mjs --check",
    "verify:theme": "node scripts/verify-theme-tokens.mjs",
    "verify:contrast": "node scripts/verify-contrast.mjs",
    "verify": "npm run check:secrets && npm run verify:registry && npm run verify:drift && npm run verify:thumbnails && npm run verify:three-compat && npm run verify:gl-renderer && npm run verify:theme && npm run verify:contrast"
  },
  "dependencies": {
    "@cesium-extends/drawer": "^1.3.8",
    "@mkkellogg/gaussian-splats-3d": "^0.4.7",
    "@needle-tools/gltf-progressive": "^3.6.0-beta.2",
    "@needle-tools/three-animation-pointer": "^1.1.2",
    "@perplexdotgg/bounce": "^1.8.1",
    "@sparkjsdev/spark": "^2.1.0",
    "@takram/three-atmosphere": "^0.19.1",
    "@takram/three-clouds": "^0.7.6",
    "@takram/three-geospatial": "^0.9.1",
    "@takram/three-geospatial-effects": "^0.6.4",
    "@theatre/core": "^0.7.2",
    "@theatre/studio": "^0.7.2",
    "@three.ez/batched-mesh-extensions": "^0.0.12",
    "@three.ez/simplify-geometry": "^0.0.1",
    "@turf/area": "^6.5.0",
    "@turf/helpers": "^6.5.0",
    "@tweenjs/tween.js": "^25.0.0",
    "3d-tiles-renderer": "^0.4.28",
    "animejs": "^4.5.0",
    "cannon-es": "^0.20.0",
    "cesium": "^1.142.0",
    "cesium-transform-controls": "^1.2.8",
    "chart.js": "^4.5.1",
    "coordtransform": "^2.1.2",
    "d3": "^7.9.0",
    "echarts": "^6.1.0",
    "gifenc": "^1.0.3",
    "gl-matrix": "^3.4.3",
    "gsap": "^3.15.0",
    "highlight.js": "^11.11.1",
    "jszip": "^3.10.1",
    "lil-gui": "^0.21.0",
    "pinia": "^3.0.4",
    "postprocessing": "^6.39.1",
    "satellite.js": "^7.0.1",
    "three": "^0.185.0",
    "three-bvh-csg": "^0.0.18",
    "three-geojson-geometry": "^2.1.1",
    "three-globe": "^2.45.2",
    "three-good-godrays": "^0.12.0",
    "three-gpu-pathtracer": "^0.0.24",
    "three-html-render": "^0.1.2",
    "three-mesh-bvh": "^0.9.10",
    "three-slippy-map-globe": "^1.0.6",
    "three-subdivide": "^1.1.5",
    "three-tile": "^0.11.14",
    "vue": "^3.5.39",
    "vue-cesium": "^3.2.12",
    "vue-router": "^5.1.0",
    "web-ifc": "^0.0.77"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/d3": "^7.4.3",
    "@types/node": "^26.0.1",
    "@types/three": "0.185.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^10.6.0",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "jiti": "^2.7.0",
    "playwright": "^1.61.1",
    "prettier": "^3.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.0",
    "vite-plugin-compression2": "^2.5.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.5"
  }
}
