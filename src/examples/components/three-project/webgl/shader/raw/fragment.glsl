// =====================================================
// 片元着色器（Fragment Shader）：计算每个像素的最终颜色
// =====================================================

// 设置浮点数精度为低精度
precision lowp float;

// =====================================================
// Varying 变量（从顶点着色器传递过来的插值数据）
// =====================================================

// UV 坐标（纹理坐标）
varying vec2 vUv;

// 顶点的高度值（Z 轴位置）
// 从顶点着色器计算并传递过来，用于根据波动高度调整颜色明暗
varying float vElevation;

// =====================================================
// Uniform 变量（从 JavaScript 传递的全局变量）
// =====================================================

// 纹理采样器
// 用于从纹理图片中读取颜色数据
uniform sampler2D uTexture; 

// =====================================================
// 主函数
// =====================================================
void main(){

    // 1. 计算高度系数
    // vElevation 范围：约 -0.05 到 0.05（来自顶点着色器的波动）
    // 加上 0.05 * 20.0 = 1.0，使范围变为 0.0 到 2.0
    // 这样波峰会更亮，波谷会更暗
    float height = vElevation + 0.05 * 20.0;
    
    // 2. 从纹理中采样颜色
    // texture2D：GLSL 内置函数，用于 2D 纹理采样
    // 参数 1：纹理采样器（uTexture）
    // 参数 2：UV 坐标（vUv）
    // 返回值：该 UV 位置对应的纹理颜色（RGBA）
    vec4 textureColor = texture2D(uTexture, vUv);
    
    // 3. 根据高度调整纹理颜色的亮度
    // textureColor.rgb 获取 RGB 三个通道（不包括 Alpha）
    // 乘以 height 后，波峰区域颜色更亮，波谷区域颜色更暗
    // 实现了明暗变化的波动效果
    textureColor.rgb *= height;
    
    // 4. 输出最终颜色
    // gl_FragColor 是 GLSL 内置变量，表示该像素的最终颜色
    gl_FragColor = textureColor;
}

// =====================================================
// 效果总结
// =====================================================
// 最终效果：
// 1. 显示纹理图片
// 2. 根据波动的高度调整明暗
// 3. 波峰更亮（height > 1.0）
// 4. 波谷更暗（height < 1.0）
// 5. 形成动态的波光粼粼效果
// =====================================================