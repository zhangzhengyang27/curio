// =====================================================
// 顶点着色：计算每个顶点的最终位置和传递数据给片元着色器
// =====================================================

// 设置浮点数精度为低精度
// 注意：顶点着色器通常使用 highp（高精度）进行位置计算
// 这里使用 lowp 是为了演示，实际项目中位置计算建议用 highp
// highp   -2^16 到 2^16  （高精度，适合位置计算）
// mediump -2^10 到 2^10  （中精度，平衡性能和精度）
// lowp    -2^8  到 2^8   （低精度，适合颜色计算，性能最优）
precision lowp float;

// =====================================================
// Attribute 变量（每个顶点独有的数据）
// =====================================================

// 顶点位置（局部坐标/模型坐标）
// vec3：三维向量 (x, y, z)，由 Three.js 自动从几何体传递
attribute vec3 position;

// UV 坐标（纹理坐标）：用于将纹理正确映射到几何体表面
// vec2：二维向量 (u, v)，范围：(0,0) 到 (1,1)
attribute vec2 uv;

// =====================================================
// Uniform 变量（所有顶点共享的数据，从 CPU 传递）
// =====================================================

// 模型矩阵（Model Matrix）
// 将顶点从局部空间转换到世界空间：包含物体的位置、旋转、缩放信息
uniform mat4 modelMatrix;

// 视图矩阵（View Matrix）
// 将顶点从世界空间转换到相机空间：包含相机的位置和朝向信息
uniform mat4 viewMatrix;

// 投影矩阵（Projection Matrix）
// 将顶点从相机空间转换到裁剪空间（NDC）：将顶点坐标从相机空间转换到裁剪空间，实现透视效果（近大远小）
uniform mat4 projectionMatrix;

// 时间变量（用于动画）
// 从 JavaScript 每帧更新传入，单位：秒
uniform float uTime;

// =====================================================
// Varying 变量（传递给片元着色器的数据）
// =====================================================

// 传递 UV 坐标给片元着色器
// 片元着色器会对三角形内部的 UV 坐标进行插值
varying vec2 vUv;

// 传递顶点高度给片元着色器
// 用于在片元着色器中根据高度调整颜色
varying float vElevation;

void main(){
    // 1. 传递 UV 坐标给片元着色器
    vUv = uv;
    
    // 2. 计算世界空间位置
    // 将局部坐标转换为世界坐标
    // vec4(position, 1.0)：将 vec3 转为齐次坐标 vec4。最后的 1.0 表示这是一个点（不是方向向量）
    vec4 modelPosition = modelMatrix * vec4(position, 1.0);
    
    // -----------------------------------------------
    // 3. 创建波动效果
    // -----------------------------------------------
    
    // 第一个波动（沿 X 轴方向）
    // sin() 函数产生周期性波动，范围 [-1, 1]
    // (modelPosition.x + uTime) * 10.0：
    //   - modelPosition.x：让波动沿 X 轴变化
    //   - + uTime：让波动随时间移动
    //   - * 10.0：控制波动频率（数值越大，波纹越密集）
    // * 0.05：控制波动振幅（数值越大，波动越剧烈）
    modelPosition.z = sin((modelPosition.x + uTime) * 10.0) * 0.05;
    
    // 第二个波动（沿 Y 轴方向）
    // 使用 += 叠加效果，形成网格状波纹
    // 两个方向的波动叠加，产生更复杂的波浪效果
    modelPosition.z += sin((modelPosition.y + uTime) * 10.0) * 0.05;
    
    // 4. 保存高度值，传递给片元着色器
    // 片元着色器会用这个值来调整颜色明暗
    vElevation = modelPosition.z;

    // 5. 计算最终的屏幕位置
    // MVP 变换（Model-View-Projection）
    // 顺序：世界空间 -> 相机空间 -> 裁剪空间
    // gl_Position 是 GLSL 内置变量，表示顶点的最终位置
    gl_Position = projectionMatrix * viewMatrix * modelPosition;
}

// =====================================================
// 变换流程总结
// =====================================================
// 1. 局部空间（Local Space）
//    ↓ modelMatrix
// 2. 世界空间（World Space）← 在这里添加波动效果
//    ↓ viewMatrix
// 3. 相机空间（View/Eye Space）
//    ↓ projectionMatrix
// 4. 裁剪空间（Clip Space）
//    ↓ 自动透视除法
// 5. NDC 标准化设备坐标（Normalized Device Coordinates）
//    ↓ 视口变换
// 6. 屏幕空间（Screen Space）
// =====================================================